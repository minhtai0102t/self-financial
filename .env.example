# Copy to .env (never commit real values).

# Runtime connection (Neon PostgreSQL pooler)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Optional direct connection for Prisma migrations
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=require"

# Comma-separated Gemini API keys for automatic rotation
NEXT_PUBLIC_GEMINI_API_KEYS="your-gemini-api-key-1,your-gemini-api-key-2"

# Better Auth (at least 32 random characters)
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Optional OAuth Providers (Google / GitHub)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

